# Supabase Database Configuration (Session Pooler - IPv4 supported)
# Format: jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<YOUR_PROJECT_REF>
DB_PASSWORD=your_supabase_password

# JWT Secret (256-bit hex)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# Brevo Email Configuration (Recommended: No custom domain needed, sends to any recipient)
# Sign up at https://brevo.com and get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=PriceHawk

# Resend Email Configuration (Alternative)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PriceHawk <onboarding@resend.dev>
RESEND_OVERRIDE_RECIPIENT=
