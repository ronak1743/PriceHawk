{
  "manifest_version": 3,
  "name": "PriceHawk - Price Tracker",
  "version": "0.0.1",
  "description": "Smart price tracking for Amazon and Flipkart with drop alerts.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*"
  ]
}
